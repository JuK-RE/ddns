{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ddns-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ddns-api-db",
      "database_id": "73776b99-1cfc-48a9-bfc2-ce3f0519c4cc",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "vars": {
    // URL pública do front (ddns-ui), sem barra no fim. Usada pra:
    // - CORS/CSRF (origem confiável);
    // - callback do OAuth: FRONTEND_URL + /api/auth/{google,github}
    //   (cadastre essas URLs no Google Cloud Console e no OAuth App do GitHub);
    // - redirecionar de volta pro front depois do login.
    // O front (Vercel) repassa /api/* pra este Worker (rewrite no vercel.json
    // do ddns-ui). Pra dev, sobrescreva no .dev.vars (ver .dev.vars.example).
    "FRONTEND_URL": "https://ddns.juk.re"
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}